# PyHoldem Pro React frontend
# -------------------------------------------------
# Build stage: install + run Vite production build.
# Runtime stage: nginx serving the static dist/ on :80.

FROM node:20-alpine AS builder

WORKDIR /app

# Cache npm install separately from source changes.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./

# Allow the API URL to be baked in at build time. docker-compose passes
# http://localhost:8000 so the static bundle calls the API on the host.
ARG VITE_API_URL=http://localhost:8000
ARG VITE_WS_URL
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_WS_URL=${VITE_WS_URL}

RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Single-page-app fallback: any unknown route serves index.html so the React
# router can take over.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
